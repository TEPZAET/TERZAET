<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_screen_ambient" android:fillViewport="true">
    <LinearLayout android:id="@+id/aboutContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingTop="40dp" android:paddingBottom="34dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:background="@drawable/glass_panel">
            <ImageView android:id="@+id/aboutLogo" android:layout_width="84dp" android:layout_height="84dp" android:contentDescription="TERZAET" android:src="@drawable/terzaet_logo" />
            <TextView android:id="@+id/aboutTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:fontFamily="sans" android:letterSpacing="0.08" android:text="TERZAET" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/versionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_glass_field" android:paddingHorizontal="14dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="О ПРОЕКТЕ" android:textColor="@color/text_tertiary" android:textSize="11sp" android:letterSpacing="0.1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_panel" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Независимый форк" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="TERZAET — независимый неофициальный форк OpenFluxAndroid/OpenFlux." android:textColor="@color/text_secondary" android:textSize="14sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:background="#55A9ADA9" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Конфиденциальность" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:lineSpacingExtra="3dp" android:text="Конфигурации хранятся на устройстве. Пароль от VDS не сохраняется." android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="ЧАСТЫЕ СИТУАЦИИ" android:textColor="@color/text_tertiary" android:textSize="11sp" android:letterSpacing="0.1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_panel" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сервер не отвечает" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Проверьте оплату VDS, IP, SSH-порт и доступ сервера к интернету." android:textColor="@color/text_secondary" android:textSize="13sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="#55A9ADA9" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Яндекс запросил CAPTCHA" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Создайте новый документ или смените IP VDS." android:textColor="@color/text_secondary" android:textSize="13sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="#55A9ADA9" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VPN не запускается" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Подтвердите системный запрос VPN и отключите другой VPN." android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
