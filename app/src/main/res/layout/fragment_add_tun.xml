<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_ambient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="42dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Конфигурация"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Документ — основной транспорт, Hysteria 2 — дополнительный"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:tag="glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/GlassTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Имя">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name"
                    style="@style/GlassEditText"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/GlassTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Ссылка Hysteria 2 (необязательно)"
                app:helperText="Добавьте готовую ссылку hysteria2:// для быстрого подключения.">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hysteriaUri"
                    style="@style/GlassEditText"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:inputType="textUri"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoFallbackSwitch"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="Автопереход на документ при блокировке Hysteria"
                android:textColor="@color/text_primary"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/GlassTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Ссылка на документ">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/documentUrl"
                    style="@style/GlassEditText"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:inputType="textUri"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/encryptionSwitch"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:text="Дополнительное шифрование"
                android:textColor="@color/text_primary"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/encryptionKeyContainer"
                style="@style/GlassTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Ключ шифрования"
                android:visibility="gone"
                app:endIconMode="password_toggle"
                app:helperText="Минимум 16 символов. Ключ хранится только на этом устройстве.">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/encryptionKey"
                    style="@style/GlassEditText"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:inputType="textPassword"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/vdsAdminContainer" android:tag="glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/glass_panel" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Управление VDS" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Данные сохраняются без SSH-пароля" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="IP или домен VDS">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/adminHost" style="@style/GlassEditText" android:layout_width="match_parent" android:layout_height="58dp" android:inputType="textUri" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Пользователь">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/adminUser" style="@style/GlassEditText" android:layout_width="match_parent" android:layout_height="58dp" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="96dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:hint="Порт">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/adminPort" style="@style/GlassEditText" android:layout_width="match_parent" android:layout_height="58dp" android:inputType="number" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="Добавить"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/updateVdsButton"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp"
            android:text="Обновить документ на VDS" android:textAllCaps="false" android:textColor="#2E7552"
            android:backgroundTint="#DDE0E3" android:visibility="gone" app:cornerRadius="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/installHysteriaButton"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp"
            android:text="Установить Hysteria 2" android:textAllCaps="false" android:textColor="#2E7552"
            android:backgroundTint="#DDE0E3" android:visibility="gone" app:cornerRadius="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/removeFromVdsButton"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp"
            android:text="Удалить TERZAET с VDS" android:textAllCaps="false" android:textColor="@color/state_error"
            android:backgroundTint="#FFF0F0" android:visibility="gone" app:cornerRadius="20dp" app:strokeColor="#C78282" app:strokeWidth="1dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
