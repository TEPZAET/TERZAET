<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_screen_ambient">
    <io.github.p1neapplexpress.openflux.ui.widget.CropVideoView android:id="@+id/onboardingVideo" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.82" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#38FFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom" android:orientation="vertical" android:padding="18dp" android:paddingBottom="26dp">
        <LinearLayout android:id="@+id/onboardingCard" android:tag="glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_panel" android:elevation="10dp" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/onboardingStep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01 / 04" android:textColor="@color/text_secondary" android:textSize="11sp" android:letterSpacing="0.14" />
            <TextView android:id="@+id/onboardingTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Добро пожаловать" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/onboardingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Спокойное и понятное управление защищённым подключением." android:textColor="@color/text_secondary" android:textSize="15sp" android:lineSpacingExtra="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="22dp" android:gravity="center" android:orientation="horizontal">
                <View android:id="@+id/dotOne" android:layout_width="24dp" android:layout_height="4dp" android:background="#7A3B4045" />
                <View android:id="@+id/dotTwo" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginStart="6dp" android:background="#4070777D" />
                <View android:id="@+id/dotThree" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginStart="6dp" android:background="#4070777D" />
                <View android:id="@+id/dotFour" android:layout_width="8dp" android:layout_height="4dp" android:layout_marginStart="6dp" android:background="#4070777D" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/onboardingNext" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:text="Продолжить" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:backgroundTint="#383D42" app:cornerRadius="22dp" xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
