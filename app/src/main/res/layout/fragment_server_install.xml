<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_ambient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="44dp"
        android:paddingBottom="36dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Свой сервер" android:textColor="@color/text_primary" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
            android:text="TERZAET установится отдельно и не изменит другие VPN-сервисы."
            android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="3dp" />

        <LinearLayout android:tag="glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:background="@drawable/glass_panel" android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Название сервера">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverName" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textCapSentences" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="IP или домен">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverHost" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textUri" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Пользователь">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverUser" android:layout_width="match_parent" android:layout_height="56dp" android:text="root" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="96dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:hint="Порт">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverPort" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" android:text="22" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="SSH-пароль" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverPassword" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textPassword" android:singleLine="true" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/serverDocumentContainer" style="@style/GlassTextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ссылка на документ Яндекса" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_help_circle" app:endIconContentDescription="Как получить документ Яндекса">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverDocument" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textUri" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/serverEncryptionSwitch"
                android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp"
                android:text="Дополнительное шифрование" android:textColor="@color/text_primary" app:useMaterialThemeColors="true" />
            <com.google.android.material.textfield.TextInputLayout style="@style/GlassTextInput" android:id="@+id/serverEncryptionContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Ключ шифрования" android:visibility="gone" app:endIconMode="password_toggle" app:helperText="Создаётся локально и сохраняется только на этом устройстве.">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverEncryption" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textPassword" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/copyEncryptionKey" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="48dp" android:text="Копировать ключ" android:textAllCaps="false" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/installStatusContainer" android:tag="glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_field" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
            <ProgressBar android:id="@+id/installSpinner" style="?android:attr/progressBarStyleSmall" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginEnd="12dp" android:indeterminate="true" android:visibility="gone" />
            <TextView android:id="@+id/installStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Готово к установке" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/installProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp"
            android:indeterminate="false" android:max="100" android:progress="0" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/installButton"
            android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="16dp"
            android:text="Установить и добавить" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:backgroundTint="#383D42" app:cornerRadius="20dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
