<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_screen_ambient" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingTop="42dp" android:paddingBottom="34dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Настройки" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Видео и уведомления о состоянии соединения" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <LinearLayout android:tag="glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/glass_panel" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Интенсивность видео" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Видимость фонового видео на главном экране" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <SeekBar android:id="@+id/videoIntensity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:max="80" android:progress="80" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settingNotifications" android:tag="glass" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="12dp" android:background="@drawable/glass_panel" android:paddingHorizontal="18dp" android:text="Уведомлять о восстановлении" android:textColor="@color/text_primary" android:checked="true" app:useMaterialThemeColors="true" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
