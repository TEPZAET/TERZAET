<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:tag="glass" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/glass_panel" android:elevation="3dp" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:id="@+id/serverDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dropdown_dot" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/serverName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/serverType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/serverEdit" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:src="@drawable/ic_edit" app:tint="@color/text_secondary" android:contentDescription="Редактировать" />
        <ImageButton android:id="@+id/serverDelete" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:src="@drawable/ic_delete" app:tint="@color/state_error" android:contentDescription="Удалить" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/serverYandex" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="ЯDoc" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/serverHysteria" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Hy2" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
